# ---------------------------------------------------------------------------
# Dream Job - environment configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
DREAMJOB_ENV=development
DREAMJOB_HOST=127.0.0.1
DREAMJOB_PORT=8000
DREAMJOB_DATA_DIR=data
DREAMJOB_DB_PATH=data/dreamjob.db

# Master key for encryption at rest (NFR-201). Generate with:
#   python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
DREAMJOB_MASTER_KEY=

# Secret used to sign session tokens (NFR-202)
DREAMJOB_SESSION_SECRET=

# --- LLM (CR-409, NFR-306: OpenAI-compatible, provider-agnostic) ------------
DREAMJOB_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# Optional extra keys for the same endpoint (e.g. several Groq free-tier keys):
# on a 429 the client moves to the next key instead of waiting.
DEEPSEEK_API_KEY_2=
DEEPSEEK_API_KEY_3=
DEEPSEEK_API_KEY_4=
DEEPSEEK_API_KEY_5=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DREAMJOB_LLM_MODEL_CHEAP=deepseek-chat
DREAMJOB_LLM_MODEL_STRONG=deepseek-reasoner
# Optional fallback endpoint, tried only when the main one still fails after
# all its keys and retries (e.g. Groq above, DeepSeek here).  No key = off.
DREAMJOB_FALLBACK_LLM_BASE_URL=https://api.deepseek.com
DREAMJOB_FALLBACK_LLM_API_KEY=
DREAMJOB_FALLBACK_LLM_MODEL_CHEAP=deepseek-chat
DREAMJOB_FALLBACK_LLM_MODEL_STRONG=deepseek-chat
# Priced separately from the main endpoint, and deliberately non-zero: the main
# endpoint is a free tier whose rates are legitimately 0, and one shared rate
# pair recorded every paid fallback call at 0.00 EUR in the call log.
DREAMJOB_FALLBACK_LLM_COST_PER_1M_INPUT_EUR=0.25
DREAMJOB_FALLBACK_LLM_COST_PER_1M_OUTPUT_EUR=1.00

# Optional local model for privacy-sensitive steps (NFR-306, CR-410).
# Any OpenAI-compatible endpoint (Ollama, vLLM, LM Studio).
DREAMJOB_LOCAL_LLM_BASE_URL=
DREAMJOB_LOCAL_LLM_MODEL=
DREAMJOB_LOCAL_LLM_API_KEY=not-needed
# Route these task groups to the local model: profile,cv,motivation
DREAMJOB_LOCAL_LLM_TASKS=

# Optional embeddings model for the semantic index over the corpus (FR-261).
# Empty disables the index entirely; the base URL falls back to the local model
# then the main provider's.
DREAMJOB_EMBEDDINGS_MODEL=
DREAMJOB_EMBEDDINGS_BASE_URL=

# Per-campaign token budget (NFR-104)
DREAMJOB_DEFAULT_TOKEN_BUDGET=2000000
# How many opportunities per campaign are also scored by the model (NFR-104).
# The whole corpus is always ranked deterministically; this caps the semantic
# dream-fit and rationale calls, at ~10k tokens each.
DREAMJOB_LLM_SCORED_LIMIT=500
DREAMJOB_LLM_COST_PER_1M_INPUT_EUR=0.25
DREAMJOB_LLM_COST_PER_1M_OUTPUT_EUR=1.00

# --- Email dispatch (FR-325). Two backends: gmail_oauth | resend ------------
DREAMJOB_MAIL_BACKEND=resend
DREAMJOB_MAIL_FROM=stephane@stepvda.com
DREAMJOB_MAIL_FROM_NAME=Stephane van der Aa

# Resend (https://resend.com) - API key added later by the user
RESEND_API_KEY=

# Gmail OAuth (NFR-204: scoped to send + read-bounce only)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://127.0.0.1:8000/api/mail/gmail/callback

# IMAP polling for bounce/reply detection (FR-326)
DREAMJOB_IMAP_HOST=imap.gmail.com
DREAMJOB_IMAP_PORT=993

# --- Sending guard rails (FR-325, RK-05) -----------------------------------
# The transport guard. While this is true every send runs the whole path -
# recipient resolution, the guard rails below, the MIME assembly with the
# tailored CV attached and the objection sentence - and then stops at the
# transport: a dispatch row is written with delivery_status='dry_run' and the
# assembled message is saved under data/generated/dry_run/ for inspection.
# Nothing leaves the machine. It defaults to true; arming a real send means
# setting it to false here and restarting the API. Enforced server-side in
# dreamjob/mail/dry_run.py, so no caller and no screen can route around it.
DREAMJOB_MAIL_DRY_RUN=true
DREAMJOB_SEND_DAILY_CAP=25
DREAMJOB_SEND_MIN_INTERVAL_SECONDS=90
DREAMJOB_SEND_WINDOW_START=08:30
DREAMJOB_SEND_WINDOW_END=17:30

# --- Egress layer (FR-182, IR-102) -----------------------------------------
DREAMJOB_USER_AGENT=DreamJobBot/0.1 (+https://stepvda.net/dreamjob; contact stephane@stepvda.com)
DREAMJOB_HTTP_CACHE_TTL_SECONDS=86400
# Vacancy boards change within the hour, registries yearly: vacancy fetches
# revalidate a cached board older than this (a 304 when unchanged) instead of
# serving it for the full general TTL above.
DREAMJOB_VACANCY_CACHE_TTL_SECONDS=3600
# Volume comes from more domains, never from hammering one: 0.5 rps is the
# compliant rate that actually runs.  Nobody should "fix" these upward.
# This is the ceiling the limiter enforces on every host, so it is also what
# the source catalogue records and what the plan estimate is priced from: an
# adapter that asks for 1.0 still gets 0.5, and a host that publishes a
# Crawl-delay gets less again (FR-182, FR-185).
DREAMJOB_PER_DOMAIN_RPS=0.5
DREAMJOB_HTTP_MAX_CONCURRENCY=20
DREAMJOB_RESPECT_ROBOTS=true

# --- Background jobs (NFR-102, CR-408) --------------------------------------
# Jobs do not run on the loop that serves HTTP; each gets a thread from this
# pool and its own event loop inside it (jobs/runner.py).  Both numbers are
# bounded on purpose: a starved event loop must not be traded for an exhausted
# process, and there is still only one writer.  Raising these buys parallel
# campaigns, not a faster one, and every extra thread queues on that writer.
DREAMJOB_JOB_POOL_SIZE=4
# Threads shared by all running jobs for their own blocking calls.
DREAMJOB_JOB_IO_THREADS=8
# How long a writer waits for the single writer before giving up.  Requests
# are impatient (a person is waiting, and an error beats a page that never
# loads); job work is patient but not infinitely so.
DREAMJOB_WRITE_WAIT_SECONDS=15
DREAMJOB_BULK_WRITE_WAIT_SECONDS=600
# A 404/410 is not re-probed for a week; a 429/5xx is re-tried after six hours.
DREAMJOB_NEGATIVE_CACHE_TTL_SECONDS=604800
# How long a stored raw document is kept before it may be pruned (DR-102).
DREAMJOB_RAW_DOCUMENT_RETENTION_DAYS=30
# Honour the Crawl-delay a site publishes (europa.eu asks for 10 s,
# api.lever.co for 1 s).  Leave this on: it is the reason those sites have no
# cause to block us.
DREAMJOB_HONOUR_CRAWL_DELAY=true
# Adzuna job search (board.adzuna), free key from developer.adzuna.com.  Left
# empty, the source reports itself unavailable and is never planned.
DREAMJOB_ADZUNA_APP_ID=
DREAMJOB_ADZUNA_APP_KEY=

# --- Company registries (FR-241, FR-245, RK-06) ----------------------------
# Optional, per deployment.  Without a key the registry reports itself
# unavailable, the plan item says which key is missing, and the company's
# financial profile is marked estimated - nothing is invented and no licence is
# scraped around.  Each can also be stored at run time as the app setting
# registry.secret.<lowercased name> (FR-363).
# NBB Central Balance Sheet Office - Belgian annual accounts, free subscription
# at https://ws.cbso.nbb.be (the only source of BE filings; BE is the primary
# jurisdiction, so this is the one worth having).
NBB_CBSO_SUBSCRIPTION_KEY=
# UK Companies House REST API
COMPANIES_HOUSE_API_KEY=
# Dutch Chamber of Commerce (KvK) Handelsregister API
KVK_API_KEY=
# OpenCorporates cross-jurisdiction directory
OPENCORPORATES_API_TOKEN=

# --- Browser automation (FR-201, section 3.5.2) ----------------------------
DREAMJOB_CDP_URL=http://127.0.0.1:9222
DREAMJOB_BROWSER_PROFILE_DIR=.chrome-profile
DREAMJOB_BROWSER_MIN_DELAY_MS=2500
DREAMJOB_BROWSER_MAX_DELAY_MS=6000

# --- Background scheduler (FR-401..403, NFR-303, FR-364) -------------------
# On by default: watchlist checks, digests, reply/bounce polling, follow-ups,
# contact retention and LLM prompt redaction all lived behind an admin API call
# nothing made, so on a running installation none of them ran.  Set
# DREAMJOB_SCHEDULER_ENABLED=0 to run them from cron instead
# (`python -m dreamjob.monitoring.scheduler --once`).  DREAMJOB_SCHEDULER_AUTOSTART,
# when set, still overrides the setting.
DREAMJOB_SCHEDULER_ENABLED=1
DREAMJOB_SCHEDULER_TICK_SECONDS=60
DREAMJOB_SCHEDULER_AUTOSTART=
# How often the scheduler re-reads the ATS boards behind the ranked lists and
# adds new postings (pipeline/vacancy_refresh.py).  0 turns the task off.
DREAMJOB_VACANCY_REFRESH_SECONDS=600
# How often connected mailboxes are read for the job-alert e-mails of the
# senders declared in mail/job_alerts.py ALERT_SOURCES.  0 turns the task off.
DREAMJOB_JOB_ALERTS_SECONDS=900
# A non-Gmail mailbox (Yahoo) read for those alerts over IMAP with an app
# password (Yahoo: Account security -> Generate app password).  The alerts go
# to the account whose login e-mail is DREAMJOB_ALERTS_IMAP_USER.  Empty = off.
DREAMJOB_ALERTS_IMAP_HOST=imap.mail.yahoo.com
DREAMJOB_ALERTS_IMAP_USER=
DREAMJOB_ALERTS_IMAP_PASSWORD=
# The account those alerts go to, when its login e-mail differs from the mailbox.
DREAMJOB_ALERTS_IMAP_OWNER=

# --- Geocoding (FR-144) ----------------------------------------------------
DREAMJOB_GEOCODER_URL=https://nominatim.openstreetmap.org

# --- Google Calendar (FR-423) ----------------------------------------------
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# --- Logging (NFR-701, NFR-702) --------------------------------------------
# Six rotating files land in DREAMJOB_LOG_DIR: app, requests, database,
# frontend, audit, and errors.log which collects every warning and above from
# all of them.  Format 'text' is aligned for a person, 'json' is one object
# per line for a shipper.  A request slower than the threshold is a warning.
DREAMJOB_LOG_DIR=logs
DREAMJOB_LOG_LEVEL=INFO
DREAMJOB_LOG_FORMAT=text
DREAMJOB_LOG_MAX_MB=10
DREAMJOB_LOG_BACKUPS=5
DREAMJOB_LOG_SLOW_REQUEST_MS=1500
# Statement tracing costs a callback per SQL statement: leave DREAMJOB_LOG_SQL
# unset for on-outside-production, 0 to switch it off.  A statement slower than
# the query threshold is a warning with the SQL shape - never its values.
# DREAMJOB_LOG_SQL=1
DREAMJOB_LOG_SLOW_QUERY_MS=200
